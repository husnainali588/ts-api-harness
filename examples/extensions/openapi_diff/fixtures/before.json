{
  "openapi": "3.1.0",
  "info": { "title": "users", "version": "1" },
  "paths": {
    "/v1/users": {
      "get": { "responses": { "200": { "description": "page" }, "422": { "description": "invalid" } } },
      "post": { "responses": { "201": { "description": "created" }, "409": { "description": "duplicate" } } }
    },
    "/v1/users/{id}": {
      "get": { "parameters": [{ "name": "id", "in": "path", "required": true }], "responses": { "200": { "description": "ok" }, "404": { "description": "missing" } } },
      "delete": { "parameters": [{ "name": "id", "in": "path", "required": true }], "responses": { "204": { "description": "gone" } } }
    }
  }
}
