# Copy to .env and fill in. Never commit .env.
# One OpenRouter key is enough for both drivers.
OPENROUTER_API_KEY=

# Optional native keys (graders may use these instead of OpenRouter)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides. Leave empty to use the cheapest defaults (CLAUDE.md section 5.1).
HARNESS_CLAUDE_MODEL=
HARNESS_OPENAI_MODEL=

# Hard cap on input tokens per live run
HARNESS_MAX_RUN_TOKENS=400000
