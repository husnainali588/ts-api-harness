{
  "name": "ts-api-harness",
  "version": "0.1.0",
  "private": true,
  "description": "An agent harness that governs TypeScript REST API work with hooks, gates and deterministic checks.",
  "type": "module",
  "bin": {
    "harness": "./bin/harness.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "harness": "node bin/harness.mjs"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "pluralize": "^8.0.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pluralize": "^0.0.33",
    "vitest": "^5.0.3"
  }
}
